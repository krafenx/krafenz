# Krafen FastAPI Server (.env)
HOST=0.0.0.0
PORT=8080
# PUBLIC_ORIGIN=https://krafen.me

# Администратор и подпись сессий
ADMIN_PASSWORD=change-me
SECRET_KEY=
# auto | 1 | 0
SECURE_COOKIES=auto

# Хранилище (SQLite + совместимость с JSON) и VOD-архив
# DATA_DIR=./data
# RECORD_DIR=./vods
GDRIVE_FOLDER_ID=1e417_q9s6SjcZHyqMYzbVs8OHqfY5Ifk
# Опционально (для >100 папок в Google Drive и точных размеров файлов):
# GDRIVE_API_KEY=

# Twitch / IGDB (https://dev.twitch.tv/console)
TWITCH_CHANNEL=krafen
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=

# Музыка: Spotify Web API + Last.fm fallback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_USER=krafen
LASTFM_API_KEY=

# Поиск фильмов и сериалов (https://www.themoviedb.org/settings/api)
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Discord приглашение для виджета сообщества
DISCORD_INVITE_CODE=kGdxDzxtmK

# Автообновление с GitHub без git (по умолчанию auto — включено на хостингах без .git)
# AUTO_UPDATE=auto
# AUTO_UPDATE_REPO=krafenx/krafenz
# AUTO_UPDATE_BRANCH=main
# AUTO_UPDATE_INTERVAL=0

# Автозапись стримов (recorder/recorder.py, запускается при RECORDER=1)
RECORDER=0
RECORDER_CHANNEL=danonsha
